# 이 파일을 terraform.tfvars 로 복사해서 값을 채운다 (terraform.tfvars 는 커밋 금지)
# 내 IP 확인: https://checkip.amazonaws.com (SSH는 이 IP에서만 접속 가능)
my_ip_cidr = "203.0.113.10/32"

# 대시보드(80) 허용 범위. 기본은 전체 공개. 시연이 끝나면 내 IP로 다시 잠글 수 있다
# dashboard_allowed_cidrs = ["203.0.113.10/32"]

# public_key_path = "~/.ssh/id_ed25519.pub"
# instance_type   = "t3.small"
