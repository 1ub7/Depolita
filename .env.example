DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 배포를 허용할 GitHub 계정(쉼표로 구분). 비워 두면 전부 거절
# 예) ALLOWED_ACCOUNTS=1ub7,friend1
# * 는 모든 계정 허용. API 키만 있으면 누구의 코드든 이 서버에서 빌드·실행되므로 필요할 때만 쓴다
ALLOWED_ACCOUNTS=
# 대시보드 접속용 키. 생성: openssl rand -hex 32 (이 키를 받은 사람만 Depolita를 쓸 수 있다)
DEPOLITA_API_KEY=여기에_생성한_키
PUBLIC_HOST=localhost
# DOCKER_HOST=unix:///var/run/docker.sock

# web (nginx)
# 로컬: 3000 / EC2(docker-compose.prod.yml): 80
WEB_PORT=3000
API_UPSTREAM=http://host.docker.internal:8081
